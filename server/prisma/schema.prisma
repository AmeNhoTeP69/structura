generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  EMPLOYEE
  ADMIN
}

enum ProjectRequestStatus {
  DRAFT
  SUBMITTED
  PENDING
  UNDER_REVIEW
  REFUSED
  WAITING_CLIENT_ACCEPTANCE
  APPROVED
  CANCELLED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum RequestDocumentType {
  HOUSE_DESIGN
  BUILDING_PERMIT
  LAND_PLAN
  TECHNICAL_FILE
  BUDGET_FILE
  OTHER
}

enum ProjectDocumentType {
  REQUEST_COPY
  CONTRACT
  PLAN
  REPORT
  SITE_PHOTO
  INVOICE
  OTHER
}

enum ProjectDocumentVisibility {
  ALL
  TEAM_ONLY
}

enum TimelineLogType {
  COMMENT
  STATUS_UPDATE
  PROGRESS_UPDATE
  REQUEST
  NOTE
}

enum TimelineLogVisibility {
  ALL
  TEAM_ONLY
}

enum NotificationType {
  REQUEST_STATUS_CHANGED
  REQUEST_PROPOSAL_RECEIVED
  REQUEST_APPROVED
  REQUEST_REFUSED
  PROJECT_ASSIGNED
  PROJECT_STATUS_CHANGED
  NEW_TIMELINE_LOG
  DOCUMENT_ADDED
}

enum NotificationEntityType {
  PROJECT_REQUEST
  PROJECT
  DOCUMENT
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model User {
  id                        Int                           @id @default(autoincrement())
  fullName                  String                        @map("full_name")
  email                     String                        @unique
  passwordHash              String                        @map("password_hash")
  role                      UserRole
  phone                     String?
  isActive                  Boolean                       @default(true) @map("is_active")
  createdAt                 DateTime                      @default(now()) @map("created_at")
  updatedAt                 DateTime                      @updatedAt @map("updated_at")
  employeeProfile           EmployeeProfile?
  projectRequests           ProjectRequest[]
  uploadedRequestDocuments  ProjectRequestDocument[]      @relation("UploadedRequestDocuments")
  requestStatusChanges      ProjectRequestStatusHistory[] @relation("RequestStatusChangedBy")
  clientProjects            Project[]                     @relation("ProjectClient")
  adminCreatedProjects      Project[]                     @relation("ProjectCreatedByAdmin")
  projectAssignments        ProjectAssignment[]           @relation("AssignedEmployee")
  projectAssignmentActions  ProjectAssignment[]           @relation("AssignedByAdmin")
  uploadedProjectDocuments  ProjectDocument[]             @relation("UploadedProjectDocuments")
  timelineLogs              ProjectTimelineLog[]
  projectStatusChanges      ProjectStatusHistory[]        @relation("ProjectStatusChangedBy")
  notifications             Notification[]

  @@map("users")
}

model EmployeeType {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  employeeProfiles EmployeeProfile[]

  @@map("employee_types")
}

model EmployeeProfile {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique @map("user_id")
  employeeTypeId Int           @map("employee_type_id")
  speciality     String?
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeType   EmployeeType  @relation(fields: [employeeTypeId], references: [id], onDelete: Restrict)

  @@index([employeeTypeId])
  @@map("employee_profiles")
}

model ServiceCategory {
  id          Int                   @id @default(autoincrement())
  name        String                @unique
  slug        String                @unique
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  services    ServiceCategoryItem[]

  @@map("service_categories")
}

model Service {
  id                    Int                    @id @default(autoincrement())
  name                  String
  slug                  String                 @unique
  shortDescription      String?                @map("short_description")
  fullDescription       String?                @map("full_description")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  categories            ServiceCategoryItem[]
  requestServices       ProjectRequestService[]
  projectServices       ProjectService[]

  @@map("services")
}

model ServiceCategoryItem {
  id         Int             @id @default(autoincrement())
  serviceId  Int             @map("service_id")
  categoryId Int             @map("category_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([serviceId, categoryId])
  @@index([categoryId])
  @@map("service_category_items")
}

model ProjectRequest {
  id                       Int                         @id @default(autoincrement())
  clientId                 Int                         @map("client_id")
  referenceCode            String                      @unique @map("reference_code")
  title                    String
  description              String
  location                 String
  requestedStartDate       DateTime?                   @map("requested_start_date") @db.Date
  requestedBudget          Decimal?                    @map("requested_budget") @db.Decimal(12, 2)
  adminProposedStartDate   DateTime?                   @map("admin_proposed_start_date") @db.Date
  adminProposedBudget      Decimal?                    @map("admin_proposed_budget") @db.Decimal(12, 2)
  status                   ProjectRequestStatus        @default(DRAFT)
  adminReviewNote          String?                     @map("admin_review_note")
  clientResponseNote       String?                     @map("client_response_note")
  submittedAt              DateTime?                   @map("submitted_at")
  reviewedAt               DateTime?                   @map("reviewed_at")
  clientRespondedAt        DateTime?                   @map("client_responded_at")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  client                   User                        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  services                 ProjectRequestService[]
  documents                ProjectRequestDocument[]
  statusHistory            ProjectRequestStatusHistory[]
  project                  Project?

  @@index([clientId])
  @@index([status])
  @@map("project_requests")
}

model ProjectRequestService {
  id               Int            @id @default(autoincrement())
  projectRequestId Int            @map("project_request_id")
  serviceId        Int            @map("service_id")
  quantity         Int            @default(1)
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([projectRequestId, serviceId])
  @@index([serviceId])
  @@map("project_request_services")
}

model ProjectRequestDocument {
  id               Int                 @id @default(autoincrement())
  projectRequestId Int                 @map("project_request_id")
  uploadedByUserId Int?                @map("uploaded_by_user_id")
  documentType     RequestDocumentType @map("document_type")
  fileName         String              @map("file_name")
  filePath         String              @map("file_path")
  mimeType         String?             @map("mime_type")
  fileSize         Int?                @map("file_size")
  createdAt        DateTime            @default(now()) @map("created_at")
  projectRequest   ProjectRequest      @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  uploadedByUser   User?               @relation("UploadedRequestDocuments", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  copiedToProjectDocuments ProjectDocument[]

  @@index([projectRequestId])
  @@index([uploadedByUserId])
  @@map("project_request_documents")
}

model ProjectRequestStatusHistory {
  id               Int                  @id @default(autoincrement())
  projectRequestId Int                  @map("project_request_id")
  oldStatus        ProjectRequestStatus? @map("old_status")
  newStatus        ProjectRequestStatus  @map("new_status")
  changedByUserId  Int?                 @map("changed_by_user_id")
  comment          String?
  createdAt        DateTime             @default(now()) @map("created_at")
  projectRequest   ProjectRequest       @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  changedByUser    User?                @relation("RequestStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([projectRequestId])
  @@index([changedByUserId])
  @@map("project_request_status_history")
}

model Project {
  id                  Int                   @id @default(autoincrement())
  projectRequestId    Int                   @unique @map("project_request_id")
  clientId            Int                   @map("client_id")
  referenceCode       String                @unique @map("reference_code")
  title               String
  description         String
  location            String
  startDate           DateTime?             @map("start_date") @db.Date
  endDate             DateTime?             @map("end_date") @db.Date
  budget              Decimal?              @db.Decimal(12, 2)
  status              ProjectStatus         @default(NOT_STARTED)
  progress            Int                   @default(0)
  createdByAdminId    Int?                  @map("created_by_admin_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  projectRequest      ProjectRequest        @relation(fields: [projectRequestId], references: [id], onDelete: Restrict)
  client              User                  @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdByAdmin      User?                 @relation("ProjectCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  services            ProjectService[]
  assignments         ProjectAssignment[]
  documents           ProjectDocument[]
  timelineLogs        ProjectTimelineLog[]
  statusHistory       ProjectStatusHistory[]

  @@index([clientId])
  @@index([status])
  @@index([createdByAdminId])
  @@map("projects")
}

model ProjectService {
  id         Int       @id @default(autoincrement())
  projectId  Int       @map("project_id")
  serviceId  Int       @map("service_id")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([projectId, serviceId])
  @@index([serviceId])
  @@map("project_services")
}

model ProjectAssignment {
  id                Int       @id @default(autoincrement())
  projectId         Int       @map("project_id")
  employeeUserId    Int       @map("employee_user_id")
  assignedByAdminId Int?      @map("assigned_by_admin_id")
  assignmentRole    String?   @map("assignment_role")
  isLead            Boolean   @default(false) @map("is_lead")
  assignedAt        DateTime  @default(now()) @map("assigned_at")
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeUser      User      @relation("AssignedEmployee", fields: [employeeUserId], references: [id], onDelete: Restrict)
  assignedByAdmin   User?     @relation("AssignedByAdmin", fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@unique([projectId, employeeUserId])
  @@index([employeeUserId])
  @@index([assignedByAdminId])
  @@map("project_assignments")
}

model ProjectDocument {
  id                      Int                     @id @default(autoincrement())
  projectId               Int                     @map("project_id")
  uploadedByUserId        Int?                    @map("uploaded_by_user_id")
  sourceRequestDocumentId Int?                    @map("source_request_document_id")
  documentType            ProjectDocumentType     @map("document_type")
  fileName                String                  @map("file_name")
  filePath                String                  @map("file_path")
  mimeType                String?                 @map("mime_type")
  fileSize                Int?                    @map("file_size")
  visibility              ProjectDocumentVisibility
  createdAt               DateTime                @default(now()) @map("created_at")
  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedByUser          User?                   @relation("UploadedProjectDocuments", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  sourceRequestDocument   ProjectRequestDocument? @relation(fields: [sourceRequestDocumentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([uploadedByUserId])
  @@index([sourceRequestDocumentId])
  @@map("project_documents")
}

model ProjectTimelineLog {
  id            Int                   @id @default(autoincrement())
  projectId     Int                   @map("project_id")
  authorUserId  Int                   @map("author_user_id")
  logType       TimelineLogType       @map("log_type")
  message       String
  visibility    TimelineLogVisibility
  progressValue Int?                  @map("progress_value")
  createdAt     DateTime              @default(now()) @map("created_at")
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorUser    User                  @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([authorUserId])
  @@map("project_timeline_logs")
}

model ProjectStatusHistory {
  id              Int            @id @default(autoincrement())
  projectId       Int            @map("project_id")
  oldStatus       ProjectStatus? @map("old_status")
  newStatus       ProjectStatus  @map("new_status")
  changedByUserId Int?           @map("changed_by_user_id")
  comment         String?
  createdAt       DateTime       @default(now()) @map("created_at")
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedByUser   User?          @relation("ProjectStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([changedByUserId])
  @@map("project_status_history")
}

model Notification {
  id                Int                    @id @default(autoincrement())
  userId            Int                    @map("user_id")
  type              NotificationType
  title             String
  message           String
  isRead            Boolean                @default(false) @map("is_read")
  relatedEntityType NotificationEntityType? @map("related_entity_type")
  relatedEntityId   Int?                   @map("related_entity_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ContactMessage {
  id         Int                  @id @default(autoincrement())
  fullName   String               @map("full_name")
  email      String
  phone      String?
  subject    String?
  message    String
  status     ContactMessageStatus @default(NEW)
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([status])
  @@map("contact_messages")
}
