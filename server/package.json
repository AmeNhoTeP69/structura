{
  "name": "structura-backend",
  "version": "1.0.0",
  "description": "Structura backend with PostgreSQL and Prisma schema",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "db:create": "node -r dotenv/config scripts/create-database.js",
    "db:seed": "node -r dotenv/config scripts/seed-from-json.js",
    "db:seed:services": "node -r dotenv/config scripts/seed-services.js",
    "qa:smoke": "node scripts/smoke-test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "prisma": "^6.7.0"
  }
}
